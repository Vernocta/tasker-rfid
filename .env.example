# Copy this file to .env and adjust. .env is git-ignored — never commit it.
#
#   cp .env.example .env
#
# Connection settings and secrets live here.
# RF / filter / portal / health tuning lives in config/tasker.yaml (SPEC.md section 8).

# ---------- Postgres (SPEC.md 2.4 — local-first primary) ----------
POSTGRES_USER=tasker
POSTGRES_PASSWORD=tasker
POSTGRES_DB=tasker
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Used by Alembic and by every service. Must match the five values above.
DATABASE_URL=postgresql+psycopg://tasker:tasker@localhost:5432/tasker

# ---------- MQTT broker (readers and simulator publish here) ----------
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC=tasker/reads

# ---------- Application ----------
# Path to the YAML tuning file described in SPEC.md section 8.
TASKER_CONFIG_PATH=config/tasker.yaml

# ---------- Cloud sync (SPEC.md 2.4 — asynchronous, never the primary) ----------
# Leave blank until the cloud replica exists. Sync is not built yet.
CLOUD_DATABASE_URL=
