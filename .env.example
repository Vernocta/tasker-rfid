# Copy this file to .env and adjust. .env is git-ignored — never commit it.
#
#   cp .env.example .env
#
# Connection settings and secrets live here.
# RF / filter / portal / health tuning lives in config/tasker.yaml (SPEC.md section 8).

# ---------- Postgres (SPEC.md 2.4 — local-first primary) ----------
POSTGRES_USER=tasker
POSTGRES_PASSWORD=tasker
POSTGRES_DB=tasker
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Used by Alembic and by every service. Must match the five values above.
DATABASE_URL=postgresql+psycopg://tasker:tasker@localhost:5432/tasker

# ---------- MQTT broker (readers and simulator publish here) ----------
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC=tasker/reads
# Beam-break events from the IR gates at gated portals (the exit).
MQTT_GATE_TOPIC=tasker/gates

# ---------- API ----------
# The interactive documentation lives at http://localhost:8000/docs
API_PORT=8000

# ---------- Dashboard ----------
# The warehouse screens: http://localhost:8080
DASHBOARD_PORT=8080
DASHBOARD_POLL_SECONDS=5
# Where the dashboard's JavaScript should reach the API. The browser makes
# these calls, so it must be a URL the operator's machine can reach. If the
# screen by the dock is a different machine, put this host's address here.
API_BASE_URL=http://localhost:8000
# Origins allowed to call the API from a browser. The warehouse LAN has no
# authentication anywhere, so this is not what keeps anyone out; tighten it
# if the API is ever reachable beyond the warehouse.
CORS_ALLOW_ORIGINS=*

# ---------- Ingest service ----------
# Fixed client id + persistent MQTT session, so the broker holds reads for
# ingest while it restarts and redelivers anything it never acknowledged.
# Two ingest services must never share this id.
INGEST_CLIENT_ID=tasker-ingest
LOG_LEVEL=INFO

# ---------- Application ----------
# Path to the YAML tuning file described in SPEC.md section 8.
TASKER_CONFIG_PATH=config/tasker.yaml

# ---------- Cloud sync (SPEC.md 2.4 — asynchronous, never the primary) ----------
# Until the real cloud database exists, docker compose runs a second Postgres
# that stands in for it. This is how YOU reach it from this machine; the sync
# container uses CLOUD_DATABASE_URL_INTERNAL below.
CLOUD_DATABASE_URL=postgresql+psycopg://tasker:tasker@localhost:5433/tasker_cloud
CLOUD_POSTGRES_PORT=5433
CLOUD_POSTGRES_DB=tasker_cloud

# What the sync container uses. Replace this one with the real cloud
# connection string when there is a real cloud database.
CLOUD_DATABASE_URL_INTERNAL=postgresql+psycopg://tasker:tasker@cloud:5432/tasker_cloud
